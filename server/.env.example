# AI Provider Selection (groq | gemini)
AI_PROVIDER=groq

# Groq Cloud API Key (Required if AI_PROVIDER=groq)
GROQ_API_KEY=your_groq_api_key_here

# Gemini API Key (Required if AI_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Database URI (Required for other server operations)
MONGO_URI=mongodb://localhost:27017/stemvision
PORT=5000
JWT_SECRET=your_jwt_secret_here
